PORT=3003
BASE_PATH=/iaasapimgmt

# Business Cloud IaaS - "Resource Pool" costing (súčet cez všetky VM).
# Jednotkové sadzby v Kč/mesiac z kalkulačky T-Business.
# IaaS_COMMITMENT_MONTHS - defaultná dĺžka záväzku (0=bez záväzku / 12 / 24 / 36, default 12).
#   V UI (Costing → Délka závazku) sa dá prepínať za behu.
# IaaS_CPU/RAM/DISK_RATE_CZK - override len pre defaultný záväzok; prázdne = tabuľkové sadzby.
IaaS_COMMITMENT_MONTHS=12
IaaS_CPU_RATE_CZK_GHZ=
IaaS_RAM_RATE_CZK_GB=
IaaS_DISK_RATE_CZK_GB=

# PaaS: cena za 1 cloudlet (128 MiB RAM + 400 MHz CPU) / mesiac v Kč.
# Pouze informatívne (Cloudlety celkem), neovplyvňuje IaaS cenu.
IaaS_CLOUDLET_RATE_CZK=138.56

# Business Cloud IaaS: fixný mesačný poplatok za sieť + firewall (Kč/mesiac,
# kalkulačka T-Business "Networking and FW"). Platí pre všetky záväzky.
IaaS_NETWORK_FW_RATE_CZK=108

# T-Cloud (prg1.t-cloud.eu) - deployment do IaaS
TCLOUD_BASE_URL=https://prg1.t-cloud.eu/api/2.0
TCLOUD_REFERER=https://prg1.t-cloud.eu
TCLOUD_USERNAME=
TCLOUD_PASSWORD=
TCLOUD_OTP_SECRET=
TCLOUD_VLAN_UUID=
