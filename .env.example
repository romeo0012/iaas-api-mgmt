PORT=3003
BASE_PATH=/iaasapimgmt

# Business Cloud IaaS - "Resource Pool" costing (súčet cez všetky VM).
# Jednotkové sadzby v Kč/mesiac z kalkulačky T-Business.
# IaaS_COMMITMENT_MONTHS - defaultná dĺžka záväzku (0=bez záväzku / 12 / 24 / 36, default 12).
#   V UI (Costing → Délka závazku) sa dá prepínať za behu.
# IaaS_CPU/RAM/DISK_RATE_CZK - override len pre defaultný záväzok; prázdne = tabuľkové sadzby.
IaaS_COMMITMENT_MONTHS=12
IaaS_CPU_RATE_CZK_GHZ=
IaaS_RAM_RATE_CZK_GB=
IaaS_DISK_RATE_CZK_GB=

# PaaS: ceny cloudletov sú pevné podľa oficiálneho virtuozzo cenníka (objemové
# pásma; mesiac = hodinová × 730 h). Lze přepsat v .env (po restartu servera).
IaaS_PAAS_RESERVATION_PCT=15
IaaS_PAAS_RESERVED_RATES=98.84,93.88,88.91,84.02,79.06
IaaS_PAAS_DYNAMIC_RATES=148.26,144.54,140.82,137.09,133.44
IaaS_PAAS_BANDS=16,32,64,128
IaaS_PAAS_DISK_RATE_CZK=2.40
IaaS_PAAS_PUBLIC_IP_RATE_CZK=120.01

# PaaS Costing: východzia utilizácia v % (UI slider je 10–100, default 40).
IaaS_PAAS_UTILIZATION=40

# Business Cloud IaaS: fixný mesačný poplatok za public IP (Kč/IP/mesiac,
# kalkulačka T-Business). Účtuje sa len ak topológia obsahuje firewall (opnsense).
IaaS_REMOTE_BACKUP_RATE_CZK=0.68
IaaS_PUBLIC_IP_RATE_CZK=108

# T-Cloud (prg1.t-cloud.eu) - deployment do IaaS
TCLOUD_BASE_URL=https://prg1.t-cloud.eu/api/2.0
TCLOUD_REFERER=https://prg1.t-cloud.eu
TCLOUD_USERNAME=
TCLOUD_PASSWORD=
TCLOUD_OTP_SECRET=
TCLOUD_VLAN_UUID=
