# Runtime environment variables (CodeNOW) - hodnoty z .env.example.
# PORT=3000 odpovida nasazenemu runtime portu; BASE_PATH je vynechany,
# aby livenessProbe/readinessProbe na "/" vracely 200.

PORT=3000

# Business Cloud IaaS - "Resource Pool" costing (sucet cez vsetky VM)
IaaS_COMMITMENT_MONTHS=12

# PaaS: ceny cloudletov su pevne podla virtuozzo cennika (objemove pasma
# 1-16/17-32/33-64/65-128/129+: rezervovane 98.84/93.88/88.91/84.02/79.06 a
# dynamicke 148.26/144.54/140.82/137.09/133.44 Kc/cl/mes = hodinova x 730 h;
# disk 2.40 Kc/GB/mes, public IP 120.01 Kc/IP/mes). Pouze informat.

# PaaS Costing / mesiac: vychodzia utilizacia v % (range UI je 10-100)
IaaS_PAAS_UTILIZATION=40

# Business Cloud IaaS: fixny mesacny poplatok za public IP (Kc/IP/mesiac, len s firewallem/opnsense)
IaaS_PUBLIC_IP_RATE_CZK=108

# T-Cloud (prg1.t-cloud.eu) - deployment do IaaS
TCLOUD_BASE_URL=https://prg1.t-cloud.eu/api/2.0
TCLOUD_REFERER=https://prg1.t-cloud.eu

# Pozn: IaaS_CPU/RAM/DISK_RATE + TCLOUD_USERNAME/PASSWORD/OTP_SECRET/VLAN_UUID
# su tu vynechane (prazdne overrides by prepisaly tabulkove sadzby / prihlasovacie
# udaje sa zadavaju v UI deploy panelu).
